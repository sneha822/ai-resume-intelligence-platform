# Lean Streamlit frontend image for Render (talks to the API over HTTP; no backend deps).
FROM python:3.12-slim
ENV PYTHONUNBUFFERED=1
WORKDIR /app
RUN pip install --no-cache-dir "streamlit>=1.39.0" "plotly>=5.24.0" "httpx>=0.27.0"
COPY frontend ./frontend
COPY scripts ./scripts
# Binds $PORT. render.yaml calls the same script.
CMD ["sh", "scripts/start-frontend.sh"]
