# Lean Streamlit frontend image for Render (talks to the API over HTTP; no backend deps).
FROM python:3.12-slim
ENV PYTHONUNBUFFERED=1
WORKDIR /app
RUN pip install --no-cache-dir "streamlit>=1.39.0" "plotly>=5.24.0" "httpx>=0.27.0"
COPY frontend ./frontend
# Render sets $PORT; bind to it. Command is overridden in render.yaml too.
CMD ["sh", "-c", "streamlit run frontend/Home.py --server.port ${PORT:-8501} --server.address 0.0.0.0 --server.headless true --browser.gatherUsageStats false"]
