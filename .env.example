# --- App ---
ENVIRONMENT=development
DEBUG=true

# --- Database (Postgres + pgvector) ---
# Local (docker-compose):
POSTGRES_USER=airi
POSTGRES_PASSWORD=airi
POSTGRES_DB=airi
DATABASE_URL=postgresql+psycopg://airi:airi@localhost:5432/airi
# Neon (managed) example — note channel_binding=disable (Neon's proxy can't do
# SCRAM channel binding, and libpq/psycopg default to "prefer" which fails):
# DATABASE_URL=postgresql+psycopg://<user>:<pass>@<endpoint>.<region>.aws.neon.tech/<db>?sslmode=require&channel_binding=disable

# --- Ingestion mode ---
# "async" (Celery worker + Redis) or "sync" (inline, no worker/Redis — free hosting)
INGEST_MODE=async

# --- Redis / Celery (only needed when INGEST_MODE=async) ---
# Local (docker-compose):
REDIS_URL=redis://localhost:6379/0
CELERY_BROKER_URL=redis://localhost:6379/0
CELERY_RESULT_BACKEND=redis://localhost:6379/1
# Upstash (managed) example — TLS (rediss) + ssl_cert_reqs, single DB (0):
# NOTE: many ISPs block outbound port 6379; use a network that allows it.
# REDIS_URL=rediss://default:<pass>@<host>.upstash.io:6379/0?ssl_cert_reqs=required
# CELERY_BROKER_URL=rediss://default:<pass>@<host>.upstash.io:6379/0?ssl_cert_reqs=required
# CELERY_RESULT_BACKEND=rediss://default:<pass>@<host>.upstash.io:6379/0?ssl_cert_reqs=required

# --- LLM ---
# provider: anthropic | gemini | ollama
LLM_PROVIDER=anthropic
LLM_MODEL=claude-sonnet-5
ANTHROPIC_API_KEY=
# Gemini (set LLM_PROVIDER=gemini; accepts GEMINI_API_KEY or GOOGLE_API_KEY):
# GEMINI_API_KEY=
# GEMINI_MODEL=gemini-2.5-flash
OLLAMA_MODEL=llama3.2

# --- Embeddings (CPU-friendly ONNX via fastembed) ---
EMBEDDING_MODEL=BAAI/bge-base-en-v1.5
EMBEDDING_DIM=768
